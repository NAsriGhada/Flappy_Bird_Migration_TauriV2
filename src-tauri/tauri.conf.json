{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "flappybirds",
  "version": "0.1.0",
  "identifier": "flappybirds.game",
  "build": {
    "beforeDevCommand": "npm run dev:browser",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:browser",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "flappybirds",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "shortDescription": "A desktop game made in JavaScript and Tauri",
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
